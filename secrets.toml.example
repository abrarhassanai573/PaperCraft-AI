# Rename this file to secrets.toml (locally) or paste into
# Streamlit Cloud → App settings → Secrets, to enable AI features.
#
# Add EITHER key (or both — Gemini is tried first, Groq is automatic fallback).
GEMINI_API_KEY = "AIzaSy-xxxxxxxxxxxxxxxxxxxx"
GROQ_API_KEY = "gsk_xxxxxxxxxxxxxxxxxxxx"

